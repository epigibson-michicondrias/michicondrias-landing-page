# Copia este archivo a .env.local para desarrollo.
# En producción (Vercel) se configuran en Settings → Environment Variables.

# URL de la web app (frontend/ del monorepo). Si se vacía, los botones bajan a la sección de la app.
NEXT_PUBLIC_WEB_APP_URL=https://michicondrias.vercel.app

# Enlace de descarga de la app (APK o tienda). Sin él NO se muestra el botón «Descargar la app».
# Aún no hay APK publicado: dejar vacío hasta que exista un enlace real.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
