<section class="petfriendly" id="petfriendly">
    <div class="container">
        <div class="section-head split">
            <div>
                <span class="eyebrow">Pet friendly map</span>
                <h2>El mundo es más rico <span class="accent">en compañía</span></h2>
                <p class="section-sub">Más de 8,500 lugares verificados donde tu peludito es bienvenido. Restaurantes, cafeterías, parques, spas, hoteles y bares con menú perruno, agua gratis y áreas especiales.</p>
            </div>
            <a href="#petfriendly" class="btn btn-secondary">Ver mapa completo</a>
        </div>
        <div class="places">
            <div class="place">
                <div class="place-rating">⭐ 4.9</div>
                <h4>Patio Mishi Café</h4>
                <p>Café · Condesa, CDMX</p>
                <div class="place-tags"><span>🐱 Pet menu</span><span>🌿 Terraza</span></div>
            </div>
            <div class="place">
                <div class="place-rating">⭐ 4.8</div>
                <h4>La Perrera Bar</h4>
                <p>Bar · Roma Norte</p>
                <div class="place-tags"><span>🦴 Snacks gratis</span><span>🎶 Música</span></div>
            </div>
            <div class="place">
                <div class="place-rating">⭐ 4.7</div>
                <h4>Parque México</h4>
                <p>Parque · Hipódromo</p>
                <div class="place-tags"><span>🐕 Área de juego</span><span>💧 Bebederos</span></div>
            </div>
            <div class="place">
                <div class="place-rating">⭐ 5.0</div>
                <h4>Spa Michiland</h4>
                <p>Spa · Polanco</p>
                <div class="place-tags"><span>🛁 Hidromasaje</span><span>🧴 Aromaterapia</span></div>
            </div>
            <div class="place">
                <div class="place-rating">⭐ 4.6</div>
                <h4>Hotel El Huelludo</h4>
                <p>Hotel · Coyoacán</p>
                <div class="place-tags"><span>🏨 Pet friendly</span><span>🍽️ Room service</span></div>
            </div>
            <div class="place">
                <div class="place-rating">⭐ 4.9</div>
                <h4>Estética Garabatos</h4>
                <p>Estética · Del Valle</p>
                <div class="place-tags"><span>✂️ Corte</span><span>🛁 Spa</span></div>
            </div>
        </div>
    </div>
</section>
