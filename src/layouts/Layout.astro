---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Michicondrias · La plataforma de las mascotas (especialmente michis) 🐾", 
	description = "Michicondrias es el conglomerado de servicios para mascotas con especialidad en gatos. Salud, adopción, tienda, cuidado, GPS, lugares pet friendly y más. Tratamos a tu mascota como persona." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%90%BE%3C/text%3E%3C/svg%3E" />
    <meta name="generator" content={Astro.generator} />
</head>
<body>

<!-- ============= NAV ============= -->
<header class="nav" id="nav">
    <div class="container nav-inner">
        <a href="#hero" class="brand">
            <span class="brand-mark">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M12 22 L18 8 L24 20 Z M40 20 L46 8 L52 22 Z M8 36 C8 22 20 14 32 14 C44 14 56 22 56 36 C56 50 44 58 32 58 C20 58 8 50 8 36 Z" fill="currentColor"/>
                    <circle cx="24" cy="36" r="2.5" fill="#fff"/>
                    <circle cx="40" cy="36" r="2.5" fill="#fff"/>
                    <path d="M28 44 Q32 48 36 44" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/>
                </svg>
            </span>
            <span class="brand-name">Michi<strong>condrias</strong></span>
        </a>
        <nav class="nav-links" id="navLinks">
            <a href="#servicios">Servicios</a>
            <a href="#tienda">Tienda</a>
            <a href="#salud">Salud + IA</a>
            <a href="#cuidado">Cuidado</a>
            <a href="#petfriendly">Pet Friendly</a>
            <a href="#adopcion">Adopción</a>
            <a href="#perdidas">Mascotas Perdidas</a>
            <a href="#patrocinadores">Patrocinadores</a>
        </nav>
        <div class="nav-cta">
            <a href="#diagnostico" class="btn btn-ghost">Diagnóstico IA</a>
            <a href="#descargar" class="btn btn-primary">Descargar App</a>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label="Abrir menú">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<slot />

<!-- ============= FOOTER ============= -->
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="#hero" class="brand">
                    <span class="brand-mark">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 22 L18 8 L24 20 Z M40 20 L46 8 L52 22 Z M8 36 C8 22 20 14 32 14 C44 14 56 22 56 36 C56 50 44 58 32 58 C20 58 8 50 8 36 Z" fill="currentColor"/>
                            <circle cx="24" cy="36" r="2.5" fill="#fff"/>
                            <circle cx="40" cy="36" r="2.5" fill="#fff"/>
                            <path d="M28 44 Q32 48 36 44" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <span class="brand-name">Michi<strong>condrias</strong></span>
                </a>
                <p>La plataforma más completa para mascotas de Latinoamérica. Especialidad en michis, corazón para todos los peluditos.</p>
                <div class="social">
                    <a href="#" aria-label="Instagram">📷</a>
                    <a href="#" aria-label="TikTok">🎵</a>
                    <a href="#" aria-label="Facebook">📘</a>
                    <a href="#" aria-label="YouTube">▶️</a>
                </div>
            </div>
            <div class="footer-col">
                <h5>Servicios</h5>
                <a href="#tienda">Tienda en línea</a>
                <a href="#salud">Salud + IA</a>
                <a href="#cuidado">Cuidado y paseos</a>
                <a href="#petfriendly">Pet friendly</a>
                <a href="#perdidas">Mascotas perdidas</a>
            </div>
            <div class="footer-col">
                <h5>Comunidad</h5>
                <a href="#adopcion">Adopción</a>
                <a href="#patrocinadores">Patrocinadores</a>
                <a href="#descargar">App móvil</a>
                <a href="#">Blog michilover</a>
                <a href="#">Voluntariado</a>
            </div>
            <div class="footer-col">
                <h5>Empresa</h5>
                <a href="#">Sobre nosotros</a>
                <a href="#">Manifiesto</a>
                <a href="#">Prensa</a>
                <a href="#">Contacto</a>
                <a href="#">Términos y privacidad</a>
            </div>
            <div class="footer-col">
                <h5>Suscríbete</h5>
                <p>Tips, ofertas y noticias peludas en tu correo.</p>
                <form class="newsletter" id="newsletterForm">
                    <input type="email" placeholder="tu@correo.com" required />
                    <button type="submit">Unirme</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 Michicondrias · Hecho con 🐾 en México, para el mundo.</p>
            <p>Porque las mascotas no son mascotas, son familia.</p>
        </div>
    </div>
</footer>

<script>
    // ===== Nav scroll effect =====
    const nav = document.getElementById('nav');
    const handleScroll = () => {
        if (!nav) return;
        if (window.scrollY > 30) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // ===== Mobile nav toggle =====
    const navToggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    if (navToggle && navLinks) {
        navToggle.addEventListener('click', () => {
            navLinks.classList.toggle('open');
            navToggle.classList.toggle('open');
        });
    }

    // ===== Close mobile nav on link click =====
    if (navLinks) {
        navLinks.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target && target.tagName === 'A') {
                navLinks.classList.remove('open');
                if (navToggle) navToggle.classList.remove('open');
            }
        });
    }

    // ===== Newsletter submit =====
    const newsletterForm = document.getElementById('newsletterForm');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = newsletterForm.querySelector('button');
            const input = newsletterForm.querySelector('input');
            if (btn) btn.textContent = '¡Listo! 🐾';
            if (input) input.value = '';
        });
    }

    // ===== Shop category filter =====
    const shopCats = document.querySelectorAll('.shop-cat');
    const products = document.querySelectorAll('.product');
    shopCats.forEach((btn) => {
        btn.addEventListener('click', () => {
            shopCats.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            const cat = (btn as HTMLElement).dataset.cat;
            products.forEach((p) => {
                const productEl = p as HTMLElement;
                if (cat === 'all' || productEl.dataset.cat === cat) {
                    productEl.style.display = '';
                } else {
                    productEl.style.display = 'none';
                }
            });
        });
    });

    // ===== AI Modal =====
    const aiModal = document.getElementById('aiModal');
    const aiDemoBtn = document.getElementById('aiDemoBtn');
    const aiForm = document.getElementById('aiForm') as HTMLFormElement;
    const aiResult = document.getElementById('aiResult');
    const aiResultText = document.getElementById('aiResultText');

    const openModal = () => {
        if (aiModal) {
            aiModal.classList.add('open');
            aiModal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            if (aiResult) aiResult.hidden = true;
            if (aiForm) aiForm.style.display = '';
        }
    };
    const closeModal = () => {
        if (aiModal) {
            aiModal.classList.remove('open');
            aiModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }
    };

    if (aiDemoBtn) aiDemoBtn.addEventListener('click', openModal);
    document.querySelectorAll('[data-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });

    // ===== AI chip groups =====
    document.querySelectorAll('.chip-group').forEach((group) => {
        const buttons = group.querySelectorAll('.chip-btn');
        buttons.forEach((btn) => {
            btn.addEventListener('click', () => {
                buttons.forEach((b) => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });
    });

    // ===== AI Form submit =====
    if (aiForm && aiResult && aiResultText) {
        aiForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const speciesChip = aiForm.querySelector('[data-name="species"] .chip-btn.active') as HTMLElement;
            const urgencyChip = aiForm.querySelector('[data-name="urgency"] .chip-btn.active') as HTMLElement;
            const textarea = aiForm.querySelector('textarea[name="symptoms"]') as HTMLTextAreaElement;

            const species = speciesChip?.dataset.value || 'mascota';
            const urgency = urgencyChip?.dataset.value || 'moderado';
            const symptoms = textarea ? textarea.value.trim() : '';

            if (!symptoms) return;

            // Hide form, show result
            aiForm.style.display = 'none';
            aiResult.hidden = false;

            const speciesLabel = species === 'gato' ? 'michi' : species === 'perro' ? 'lomito' : 'peludito';
            let result = '';

            if (urgency === 'urgente') {
                result = `⚠️ <strong>Esto requiere atención inmediata.</strong> Por lo que describes, te recomendamos <strong>acudir ahora a una veterinaria de urgencias</strong>. Mientras tanto, mantén a tu ${speciesLabel} en un lugar tranquilo, con agua fresca disponible y obsérvalo. No mediques sin supervisión profesional.`;
            } else if (urgency === 'leve') {
                result = `Por lo que describes, parece algo <strong>leve y manejable desde casa</strong>. Te sugerimos: 1) Mantener a tu ${speciesLabel} hidratado y tranquilo, 2) Observar las próximas 24-48 horas, 3) Si los síntomas persisten o empeoran, agenda una cita con un veterinario general. También te puede ayudar nuestra <strong>sección de bienestar</strong> con productos preventivos.`;
            } else {
                result = `Lo que describes en tu ${speciesLabel} <strong>vale la pena revisarlo pronto</strong>. Nuestra IA sugiere: 1) <strong>Agenda una cita con un veterinario general</strong> en los próximos 2-3 días, 2) Toma nota de cualquier cambio (apetito, energía, evacuaciones), 3) Mientras tanto, ofrece agua fresca y evita alimentos nuevos. Te recomendamos llevar el <strong>carnet médico digital</strong> a la consulta.`;
            }

            aiResultText.innerHTML = result;
        });
    }

    // ===== Reveal on scroll =====
    const revealEls = document.querySelectorAll('.pillar, .service-card, .product, .place, .testi, .lost-feature, .sponsor, .step, .care-card');
    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const target = entry.target as HTMLElement;
                        target.style.opacity = '1';
                        target.style.transform = 'translateY(0)';
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.12, rootMargin: '0px 0px -50px 0px' }
        );

        revealEls.forEach((el) => {
            const target = el as HTMLElement;
            target.style.opacity = '0';
            target.style.transform = 'translateY(30px)';
            target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    }

    // ===== Smooth scroll for anchor links (with offset for fixed nav) =====
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
            const href = a.getAttribute('href');
            if (!href || href === '#' || href.length < 2) return;
            const target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            const offset = 80;
            const top = target.getBoundingClientRect().top + window.scrollY - offset;
            window.scrollTo({ top, behavior: 'smooth' });
        });
    });

    // ===== Counter animation for hero stats =====
    const counters = document.querySelectorAll('.hero-stats strong');
    if ('IntersectionObserver' in window && counters.length) {
        const counterObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const el = entry.target as HTMLElement;
                        const text = el.textContent || '';
                        const match = text.match(/(\d+)/);
                        if (match) {
                            const target = parseInt(match[1], 10);
                            const suffix = text.replace(match[1], '');
                            let current = 0;
                            const step = Math.max(1, Math.floor(target / 40));
                            const tick = () => {
                                current += step;
                                if (current >= target) {
                                    el.textContent = target + suffix;
                                } else {
                                    el.textContent = current + suffix;
                                    requestAnimationFrame(tick);
                                }
                            };
                            tick();
                        }
                        counterObserver.unobserve(el);
                    }
                });
            },
            { threshold: 0.5 }
        );
        counters.forEach((c) => counterObserver.observe(c));
    }

    // ===== Welcome paw print in console 🐾 =====
    console.log(
        '%c🐾 Michicondrias',
        'color: #ff7a59; font-size: 32px; font-weight: 900; font-family: Georgia;'
    );
    console.log(
        '%cLa plataforma de las mascotas (especialmente michis)',
        'color: #8b5fbf; font-size: 14px; font-weight: 700;'
    );
    console.log('%c¿Interesado en trabajar con nosotros? Escríbenos a hola@michicondrias.app 💌', 'color: #666;');
</script>
</body>
</html>
